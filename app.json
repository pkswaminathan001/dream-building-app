{
  "expo": {
    "name": "Dream Building",
    "slug": "dream-building-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.dreambuilding.app" },
    "android": { "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#ffffff" }, "package": "com.dreambuilding.app" },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": ["expo-secure-store", "expo-router"]
  }
}
